# Project X Server Environment Configuration

PORT=5001
NODE_ENV=production
JWT_SECRET=your_production_jwt_secret_change_me

# Real API Integration Keys
GEMINI_API_KEY=AIzaSyBF... (Active Google Gemini API Key)
VIDEODB_API_KEY=your_videodb_api_key_here

# 1-Click Google OAuth 2.0 Gmail Scopes (Read & Write Email Access)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REFRESH_TOKEN=1//your_user_granted_refresh_token

# Fallback SMTP / App Password
GMAIL_USER=collabs@yourcompany.com
GMAIL_APP_PASSWORD=your_gmail_app_password
META_INSTAGRAM_TOKEN=your_meta_instagram_access_token
